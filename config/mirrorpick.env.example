# Server-only configuration. Never use NEXT_PUBLIC for these values.
# Copy the fields you need into .env.local, then restart the development server.

# Main Agent conversation. The current transport needs the server-side key.
LLM_API_KEY=

# Optional Shopping candidate scoring. Leave SHOPPING_SCORING_MODE unset to use
# the deterministic fallback. URL must include the chat-completions path.
SHOPPING_SCORING_MODE=
LLM_API_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# Optional product source overrides. The defaults use the checked-in Watsons DB.
PRODUCT_DATA_MODE=
WATSONS_DB_PATH=

# Optional Stripe sandbox execution. Live keys are rejected by the backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
